# Blood Donation System - Environment Configuration Template
# Copy this file to .env and configure strong secrets in production.

# Application Configuration
APP_NAME="Blood Donation Management System"
APP_VERSION="1.0.0"
DEBUG=False

# PostgreSQL Connection String (Asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/blood_donation_db

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS

# JWT Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

